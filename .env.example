# Flask Configuration
# Required. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
FLASK_SECRET=
# Set to 1 only for local development (enables the debugger and disables secure cookies)
FLASK_DEBUG=0

# Optional bootstrap admin account (created on first start when both are set)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=System Administrator

# Email Configuration (optional)
MAIL_SERVER=localhost
MAIL_PORT=25
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@mau.edu.ng

# SMS Configuration (Twilio - optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
